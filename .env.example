DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coffee

# MCP 預設讀取 MySQL；只有明確 --demo / MCP_DATA_MODE=demo 才使用虛構資料。
MCP_DATA_MODE=mysql
MCP_PORT=3002
# 可選：MCP 專用、僅具 SELECT 權限的帳號；省略時沿用上面的 DB_USER/DB_PASSWORD。
# MCP_DB_USER=coffee_reader
# MCP_DB_PASSWORD=
# 真實 MySQL 的 HTTP 模式必填；stdio 不需要。不要把 token 放在網址或提交進 git。
# MCP_HTTP_TOKEN=
# HTTPS 轉送服務傳來的 hostname（不含協定及 port），多個以逗號隔開。
# MCP_ALLOWED_HOSTS=
# 額外允許的瀏覽器 Origin，預設只允許本機 Inspector；server-to-server 不需 Origin。
# MCP_ALLOWED_ORIGINS=
